{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SuggestOutput",
  "type": "object",
  "properties": {
    "target": { "type": "string" },
    "target_uuid": { "type": "string" },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "score": { "type": "number" },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "filetags": { "type": "array", "items": { "type": "string" } },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        },
        "required": ["uuid", "title", "score", "scores"]
      }
    }
  },
  "required": ["target", "target_uuid", "suggestions"]
}
