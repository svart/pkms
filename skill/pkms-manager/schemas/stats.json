{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "StatsOutput",
  "type": "object",
  "properties": {
    "db_root": { "type": "string" },
    "total_notes": { "type": "integer" },
    "total_links": { "type": "integer" },
    "internal_links": { "type": "integer" },
    "file_links": { "type": "integer" },
    "url_links": { "type": "integer" },
    "avg_links_per_note": { "type": "number" },
    "orphans": { "type": "integer" },
    "broken_links": { "type": "integer" },
    "disk_size_bytes": { "type": "integer" },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "directory": { "type": "string" },
          "count": { "type": "integer" }
        },
        "required": ["directory", "count"]
      }
    },
    "hubs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "title": { "type": "string" },
          "degree": { "type": "integer" }
        },
        "required": ["uuid", "title", "degree"]
      }
    },
    "recent_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" }
        },
        "required": ["uuid", "title", "path"]
      }
    }
  },
  "required": ["total_notes", "total_links", "hubs", "directories"]
}
