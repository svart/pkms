{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PathOutput",
  "type": "object",
  "properties": {
    "from": { "type": "string" },
    "to": { "type": "string" },
    "found": { "type": "boolean" },
    "hops": { "type": "integer" },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["uuid", "title"]
      }
    }
  },
  "required": ["from", "to", "found", "hops", "path"]
}
