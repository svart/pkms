{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CheckOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "db_root": { "type": "string" },
    "stats": { "type": "object", "additionalProperties": true },
    "duplicates": { "type": "object", "additionalProperties": true },
    "broken_links": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "broken_file_links": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "broken_attachment_links": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "failed_files": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "filetags_issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "self_links": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "overlinks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "cross_links": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "healthy": { "type": "boolean" }
  },
  "required": ["healthy"]
}
