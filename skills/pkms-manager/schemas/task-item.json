{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TaskItem",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "id": { "type": ["string", "integer", "object"] }
      },
      "required": ["source", "id"]
    },
    "display_id": { "type": "string" },
    "source": { "type": "string", "enum": ["pkms"] },
    "source_id": { "type": "string" },
    "title": { "type": "string" },
    "body": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["open", "done", "unknown"] },
    "state": { "type": ["string", "null"] },
    "priority": { "type": ["string", "null"] },
    "scheduled": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "raw": { "type": "string" },
            "date": { "type": ["string", "null"] }
          },
          "required": ["raw"]
        }
      ]
    },
    "deadline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "raw": { "type": "string" },
            "date": { "type": ["string", "null"] }
          },
          "required": ["raw"]
        }
      ]
    },
    "project": { "type": ["string", "null"] },
    "project_id": { "type": ["string", "null"] },
    "note_title": { "type": ["string", "null"] },
    "note_uuid": { "type": ["string", "null"] },
    "path": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "has_agenda_tag": { "type": ["boolean", "null"] },
    "is_daily_file": { "type": "boolean" },
    "daily_file_date": { "type": ["string", "null"] },
    "is_overdue": { "type": "boolean" },
    "heading_level": { "type": ["integer", "null"] },
    "line_number": { "type": ["integer", "null"] },
    "url": { "type": ["string", "null"] }
  },
  "required": [
    "id",
    "display_id",
    "source",
    "source_id",
    "title",
    "body",
    "status",
    "state",
    "priority",
    "scheduled",
    "deadline",
    "tags",
    "project",
    "project_id",
    "note_title",
    "note_uuid",
    "path",
    "has_agenda_tag",
    "is_daily_file",
    "daily_file_date",
    "heading_level",
    "line_number",
    "url",
    "is_overdue"
  ]
}
