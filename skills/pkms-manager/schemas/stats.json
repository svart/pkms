{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "StatsOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "db_root": { "type": "string" },
    "total_notes": { "type": "integer" },
    "total_links": { "type": "integer" },
    "internal_links": { "type": "integer" },
    "file_links": { "type": "integer" },
    "url_links": { "type": "integer" },
    "avg_links_per_note": { "type": "number" },
    "orphans": { "type": "integer" },
    "broken_links": { "type": "integer" },
    "disk_size_bytes": { "type": "integer" },
    "directories": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "recent_notes": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } }
  }
}
