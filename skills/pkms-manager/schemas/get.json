{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "GetOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "node": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "filetags": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" },
        "headings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "headings_count": { "type": "integer" }
      },
      "required": ["uuid", "title", "path"]
    },
    "neighbors": { "type": "object", "additionalProperties": true }
  },
  "required": ["node", "neighbors"]
}
