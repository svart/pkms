{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PathOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "from": { "type": "string" },
    "to": { "type": "string" },
    "found": { "type": "boolean" },
    "hops": { "type": "integer" },
    "path": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "required": ["from", "to", "found", "hops", "path"]
}
