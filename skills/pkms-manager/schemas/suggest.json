{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SuggestOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "target": { "type": "string" },
    "target_uuid": { "type": "string" },
    "total": { "type": "integer" },
    "showed": { "type": "integer" },
    "suggestions": { "type": "array", "items": { "$ref": "#/definitions/Suggestion" } }
  },
  "required": ["target", "target_uuid", "suggestions"],
  "definitions": {
    "Suggestion": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "score": { "type": "number" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "filetags": { "type": "array", "items": { "type": "string" } },
        "scores": { "type": "object", "additionalProperties": { "type": "number" } },
        "target_uuid": { "type": "string" },
        "heading_context": { "type": "string" }
      },
      "required": ["uuid", "title", "score"]
    }
  }
}
