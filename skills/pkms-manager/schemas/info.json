{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "InfoOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "db_root": { "type": "string" },
        "new_notes_dir": { "type": "string" },
        "daily_notes_dir": { "type": "string" },
        "ignore_patterns": { "type": "array", "items": { "type": "string" } },
        "has_config_file": { "type": "boolean" }
      }
    },
    "config_path": { "type": "string" },
    "cli_overrides": { "type": "object", "additionalProperties": true }
  },
  "required": ["config"]
}
