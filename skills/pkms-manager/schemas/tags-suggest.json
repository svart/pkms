{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TagSuggestionOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": { "$ref": "#/definitions/Target" },
    "existing_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Suggestion" }
    },
    "applied": { "type": "boolean" },
    "rag_db": { "type": "string" },
    "embedding_model": { "type": "string" }
  },
  "required": [
    "target",
    "existing_tags",
    "suggestions",
    "applied",
    "rag_db",
    "embedding_model"
  ],
  "definitions": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["note", "task"] },
        "id": { "type": "string" },
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "line_number": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "id", "uuid", "title", "path"]
    },
    "Suggestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "support": { "type": "integer", "minimum": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/Evidence" },
          "maxItems": 3
        }
      },
      "required": ["tag", "score", "support", "evidence"]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "heading_path": {
          "type": "array",
          "items": { "type": "string" }
        },
        "score": { "type": "number", "minimum": 0 }
      },
      "required": ["uuid", "title", "path", "heading_path", "score"]
    }
  }
}
