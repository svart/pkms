{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TagsOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tags": {
      "type": "array",
      "items": { "$ref": "#/definitions/Tag" }
    }
  },
  "required": ["tags"],
  "definitions": {
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["tag", "count"]
    }
  }
}
