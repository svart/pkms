{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TodoOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "total": { "type": "integer" },
    "items": { "type": "array", "items": { "$ref": "task-item.json" } },
    "group_field": { "type": "string" },
    "groups": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "task-item.json" } } }
  }
}
