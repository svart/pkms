{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TaskOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "total": { "type": "integer" },
    "items": {
      "type": "array",
      "items": { "$ref": "task-item.json" }
    },
    "created": { "type": "boolean" },
    "changed": { "type": "boolean" },
    "action": { "type": "string" },
    "item": { "$ref": "task-item.json" },
    "changes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "id": { "type": "string" },
    "new_id": { "type": ["string", "null"] },
    "path": { "type": "string" },
    "line_number": { "type": "integer" },
    "old_state": { "type": "string" },
    "new_state": { "type": "string" },
    "dry_run": { "type": "boolean" }
  },
  "examples": [
    {
      "total": 1,
      "items": [
        {
          "id": { "source": "todoist", "id": "6XGgm6PHrGgMpCFX" },
          "source": "todoist",
          "source_id": "6XGgm6PHrGgMpCFX",
          "display_id": "todoist:6XGgm6PHrGgMpCFX",
          "status": "open",
          "title": "Buy milk"
        }
      ]
    }
  ]
}
