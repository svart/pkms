{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ResolveOutput",
  "type": "object",
  "properties": {
    "query": { "type": "string" },
    "total": { "type": "integer" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "filetags": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "matched_heading_uuid": { "type": "string" }
        },
        "required": ["uuid", "title", "path", "filetags", "aliases"]
      }
    }
  },
  "required": ["query", "total", "results"]
}
