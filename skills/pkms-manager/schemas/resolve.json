{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ResolveOutput",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "query": { "type": "string" },
    "total": { "type": "integer" },
    "showed": { "type": "integer" },
    "results": { "type": "array", "items": { "$ref": "#/definitions/ResolvedNote" } }
  },
  "required": ["query", "total", "results"],
  "definitions": {
    "ResolvedNote": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "filetags": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "matched_heading_uuid": { "type": "string" },
        "has_todos": { "type": "boolean" }
      },
      "required": ["uuid", "title", "path"]
    }
  }
}
